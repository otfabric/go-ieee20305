func TestGeneratedElements(t *testing.T) {
	for _, c := range []struct {
		name xml.Name
		ok   func(any) bool
	}{
		{xml.Name{Space: "urn:test:base", Local: "Device"}, func(v any) bool { _, ok := v.(*base.Device); return ok }},
		{xml.Name{Space: "urn:test:base", Local: "DeviceList"}, func(v any) bool { _, ok := v.(*base.DeviceList); return ok }},
		{xml.Name{Space: "urn:test:base", Local: "Notification"}, func(v any) bool { _, ok := v.(*base.Notification); return ok }},
	} {
		v := base.NewElement(c.name)
		if !c.ok(v) {
			t.Errorf("NewElement(%v) = %T", c.name, v)
			continue
		}
		if got, ok := base.ElementName(v); !ok || got != c.name {
			t.Errorf("ElementName(%T) = %v, %v", v, got, ok)
		}
		if got, ok := base.ElementName(reflect.ValueOf(v).Elem().Interface()); !ok || got != c.name {
			t.Errorf("ElementName of a %T value = %v, %v", v, got, ok)
		}
	}
	if v := base.NewElement(xml.Name{Space: "urn:none", Local: "None"}); v != nil {
		t.Errorf("NewElement of an unknown name = %T", v)
	}
	if _, ok := base.ElementName(struct{}{}); ok {
		t.Error("ElementName of a non-document type")
	}
}

func TestGeneratedAnyResource(t *testing.T) {
	for _, v := range []any{
		examples.Device(1),
		examples.DeviceList(1),
		examples.Notification(1),
		examples.Resource(1),
		examples.SubscriptionBase(1),
	} {
		w := base.AnyResource{Value: v}
		out, err := xml.Marshal(w)
		if err != nil {
			t.Errorf("%T: %v", v, err)
			continue
		}
		var back base.AnyResource
		if err := xml.Unmarshal(out, &back); err != nil || !reflect.DeepEqual(back.Value, v) {
			t.Errorf("%T: round trip: %v\n%s", v, err, out)
		}
		if err := w.Validate(); err != nil {
			t.Errorf("%T: Validate: %v", v, err)
		}
	}
	if _, err := xml.Marshal(base.AnyResource{Value: struct{}{}}); err == nil {
		t.Error("a value of another type is encoded")
	}
	var back base.AnyResource
	if err := xml.Unmarshal([]byte("<x xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xsi:type=\"NoSuchType\"></x>"), &back); err == nil {
		t.Error("an unknown xsi:type is decoded")
	}
	if err := (base.AnyResource{}).Validate(); err != nil {
		t.Errorf("Validate of no value: %v", err)
	}
	if err := (base.AnyResource{Value: examples.InvalidResource()}).Validate(); err == nil {
		t.Error("Validate of an invalid value")
	}
}

