<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:sep="urn:ieee:std:2030.5:ns"
           targetNamespace="urn:ieee:std:2030.5:ns"
           elementFormDefault="qualified"
           version="2023">

  <xs:simpleType name="UInt32">
    <xs:restriction base="xs:unsignedInt"/>
  </xs:simpleType>

  <xs:simpleType name="HexBinary160">
    <xs:restriction base="xs:hexBinary">
      <xs:length value="20"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TimeType">
    <xs:annotation>
      <xs:documentation>Seconds since epoch</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:long"/>
  </xs:simpleType>

  <xs:simpleType name="DeviceStatus">
    <xs:restriction base="xs:unsignedByte">
      <xs:enumeration value="0"/>
      <xs:enumeration value="1"/>
      <xs:enumeration value="2"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="Resource" abstract="true">
    <xs:sequence/>
  </xs:complexType>

  <xs:complexType name="IdentifiedObject" abstract="true">
    <xs:complexContent>
      <xs:extension base="sep:Resource">
        <xs:sequence>
          <xs:element name="mRID" type="sep:HexBinary160" minOccurs="0"/>
          <xs:element name="description" type="xs:string" minOccurs="0"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="List">
    <xs:complexContent>
      <xs:extension base="sep:Resource">
        <xs:attribute name="all" type="sep:UInt32" use="required"/>
        <xs:attribute name="results" type="sep:UInt32" use="required"/>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="EndDevice">
    <xs:complexContent>
      <xs:extension base="sep:IdentifiedObject">
        <xs:sequence>
          <xs:element name="sFDI" type="sep:UInt32"/>
          <xs:element name="changedTime" type="sep:TimeType" minOccurs="0"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="EndDeviceList">
    <xs:complexContent>
      <xs:extension base="sep:List">
        <xs:sequence>
          <xs:element name="EndDevice" type="sep:EndDevice" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

</xs:schema>
